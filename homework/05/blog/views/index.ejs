<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Threads</title>
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>💬</text></svg>">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      background: #000;
      color: #e0e0e0;
      min-height: 100vh;
    }
    .container {
      max-width: 1300px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: 280px 1fr 350px;
      gap: 24px;
      padding: 20px;
    }
    .sidebar-left {
      position: sticky;
      top: 20px;
      height: fit-content;
    }
    .logo {
      font-size: 28px;
      font-weight: 700;
      padding: 16px;
      margin-bottom: 8px;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .logo svg { width: 32px; height: 32px; }
    .nav-item {
      display: flex;
      align-items: center;
      gap: 16px;
      padding: 14px 16px;
      font-size: 18px;
      border-radius: 30px;
      text-decoration: none;
      color: #e0e0e0;
      transition: background 0.2s;
      margin-bottom: 4px;
    }
    .nav-item:hover { background: #1a1a1a; }
    .nav-item.active { font-weight: 700; }
    .nav-item svg { width: 26px; height: 26px; }
    .profile-card {
      background: #16181a;
      border-radius: 16px;
      padding: 20px;
      margin-top: 20px;
      text-align: center;
    }
    .avatar {
      width: 80px;
      height: 80px;
      border-radius: 50%;
      background: linear-gradient(135deg, #833ab4, #fd1d1d, #fcb045);
      margin: 0 auto 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 32px;
      font-weight: 700;
      color: #fff;
    }
    .profile-name { font-weight: 700; font-size: 18px; margin-bottom: 4px; }
    .profile-handle { color: #71767b; font-size: 14px; }
    .btn-post {
      width: 100%;
      padding: 14px;
      background: #fff;
      color: #000;
      border: none;
      border-radius: 30px;
      font-weight: 700;
      font-size: 16px;
      cursor: pointer;
      margin-top: 16px;
      transition: opacity 0.2s;
    }
    .btn-post:hover { opacity: 0.9; }
    .feed {
      border-left: 1px solid #2f3336;
      border-right: 1px solid #2f3336;
      border-radius: 0;
    }
    .feed-header {
      position: sticky;
      top: 0;
      background: rgba(0,0,0,0.65);
      backdrop-filter: blur(12px);
      padding: 12px 16px;
      border-bottom: 1px solid #2f3336;
      font-weight: 700;
      font-size: 20px;
    }
    .feed-tabs {
      display: flex;
      border-bottom: 1px solid #2f3336;
    }
    .feed-tab {
      flex: 1;
      padding: 16px;
      text-align: center;
      color: #71767b;
      cursor: pointer;
      transition: background 0.2s;
    }
    .feed-tab.active {
      color: #e0e0e0;
      font-weight: 700;
      border-bottom: 4px solid #fff;
    }
    .feed-tab:hover { background: #1a1a1a; }
    .feed-content {
      display: none;
    }
    .feed-content.active { display: block; }
    .post-card {
      padding: 16px;
      border-bottom: 1px solid #2f3336;
      cursor: pointer;
      transition: background 0.2s;
    }
    .post-card:hover { background: #16181a; }
    .post-header {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 8px;
    }
    .post-avatar {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      background: linear-gradient(135deg, #833ab4, #fd1d1d, #fcb045);
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 700;
      color: #fff;
      font-size: 14px;
    }
    .post-user-info { flex: 1; }
    .post-username { font-weight: 700; font-size: 15px; text-decoration: none; color: #e0e0e0; }
    .post-username:hover { text-decoration: underline; }
    .post-handle { color: #71767b; font-size: 14px; text-decoration: none; }
    .post-handle:hover { text-decoration: underline; }
    .post-time { color: #71767b; font-size: 14px; }
    .post-content {
      font-size: 15px;
      line-height: 1.5;
      margin-left: 52px;
      margin-bottom: 12px;
    }
    .post-actions {
      display: flex;
      justify-content: space-around;
      margin-left: 52px;
      max-width: 400px;
    }
    .action-btn {
      display: flex;
      align-items: center;
      gap: 6px;
      color: #71767b;
      font-size: 13px;
      background: none;
      border: none;
      cursor: pointer;
      padding: 8px;
      border-radius: 20px;
      transition: background 0.2s, color 0.2s;
    }
    .action-btn:hover { background: #1a1a1a; }
    .action-btn svg { width: 18px; height: 18px; }
    .sidebar-right {
      position: sticky;
      top: 20px;
      height: fit-content;
    }
    .search-box {
      background: #16181a;
      border-radius: 30px;
      padding: 12px 20px;
      margin-bottom: 20px;
    }
    .search-box input {
      background: none;
      border: none;
      color: #e0e0e0;
      font-size: 15px;
      width: 100%;
      outline: none;
    }
    .search-box input::placeholder { color: #71767b; }
    .trending {
      background: #16181a;
      border-radius: 16px;
      padding: 16px;
    }
    .trending-title {
      font-weight: 700;
      font-size: 20px;
      margin-bottom: 16px;
    }
    .trending-item {
      padding: 12px 0;
      border-bottom: 1px solid #2f3336;
    }
    .trending-item:last-child { border-bottom: none; }
    .trending-category { color: #71767b; font-size: 13px; }
    .trending-name { font-weight: 700; font-size: 15px; margin: 2px 0; }
    .trending-posts { color: #71767b; font-size: 13px; }
    .auth-buttons {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }
    .btn-auth {
      padding: 14px;
      border-radius: 30px;
      font-weight: 700;
      font-size: 15px;
      cursor: pointer;
      text-decoration: none;
      text-align: center;
      transition: opacity 0.2s;
    }
    .btn-login {
      background: #fff;
      color: #000;
      border: none;
    }
    .btn-register {
      background: transparent;
      color: #fff;
      border: 1px solid #536471;
    }
    .btn-logout {
      background: transparent;
      color: #f4212e;
      border: 1px solid #f4212e;
    }
    .empty-state {
      padding: 40px 20px;
      text-align: center;
      color: #71767b;
    }
    .post-form-container {
      padding: 16px;
      border-bottom: 1px solid #2f3336;
    }
    .post-form {
      display: flex;
      gap: 12px;
    }
    .post-form-avatar {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      background: linear-gradient(135deg, #833ab4, #fd1d1d, #fcb045);
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 700;
      color: #fff;
      font-size: 14px;
      flex-shrink: 0;
    }
    .post-form-content {
      flex: 1;
    }
    .post-form textarea {
      width: 100%;
      background: none;
      border: none;
      color: #e0e0e0;
      font-size: 18px;
      resize: none;
      outline: none;
      min-height: 60px;
      font-family: inherit;
    }
    .post-form textarea::placeholder { color: #71767b; }
    .post-form-actions {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-top: 12px;
    }
    .post-form-icons {
      display: flex;
      gap: 16px;
    }
    .post-form-icon {
      color: #1d9bf0;
      cursor: pointer;
    }
    .btn-submit {
      background: #1d9bf0;
      color: #fff;
      border: none;
      padding: 10px 20px;
      border-radius: 20px;
      font-weight: 700;
      cursor: pointer;
      opacity: 0.5;
    }
    .btn-submit.active { opacity: 1; }
    .btn-submit:hover { background: #1a8cd8; }
    @media (max-width: 1100px) {
      .container { grid-template-columns: 220px 1fr; }
      .sidebar-right { display: none; }
    }
    @media (max-width: 768px) {
      .container { grid-template-columns: 1fr; padding: 0; }
      .sidebar-left { display: none; }
      .feed { border: none; }
      .logo { padding: 12px; }
    }
  </style>
</head>
<body>
  <div class="container">
    <aside class="sidebar-left">
      <a href="/" class="logo">
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"/></svg>
        Threads
      </a>
      <nav>
        <a href="/" class="nav-item active">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M22.46 7.57L12.357 2.115c-.223-.12-.49-.12-.713 0L1.543 7.57c-.364.197-.5.652-.303 1.017.135.25.394.393.66.393.12 0 .243-.03.356-.09l.815-.44L4.7 19.963c.214 1.215 1.308 2.062 2.658 2.062h9.282c1.352 0 2.445-.848 2.663-2.087l1.626-11.49.818.442c.364.197.822.06 1.017-.304.196-.364.06-.822-.304-1.017zM20.33 19.19c-.044.255-.263.435-.52.435H8.358c-.257 0-.476-.18-.52-.435L5.76 8.176l6.24-3.38 6.243 3.38-1.913 10.014zM13 13h-2v4H7v-4H5v-2h2V7h2v4h2v2z"/></svg>
          首頁
        </a>
        <a href="#" class="nav-item">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/></svg>
          搜尋
        </a>
        <a href="#" class="nav-item">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
          通知
        </a>
        <a href="#" class="nav-item">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>
          訊息
        </a>
      </nav>
      <div class="profile-card">
        <% if (user) { %>
          <div class="avatar"><%= user.username.charAt(0).toUpperCase() %></div>
          <div class="profile-name"><%= user.username %></div>
          <div class="profile-handle">@<%= user.username %></div>
          <button class="btn-post" onclick="window.location.href='/new'">發布</button>
          <a href="/logout" class="btn-auth btn-logout" style="display:block;margin-top:12px;">登出</a>
        <% } else { %>
          <div class="auth-buttons">
            <a href="/login" class="btn-auth btn-login">登入</a>
            <a href="/register" class="btn-auth btn-register">註冊</a>
          </div>
        <% } %>
      </div>
    </aside>

    <main class="feed">
      <div class="feed-header">首頁</div>
      <div class="feed-tabs">
        <div class="feed-tab active" onclick="switchTab('following')">追蹤中</div>
        <div class="feed-tab" onclick="switchTab('public')">大家的貼文</div>
      </div>
      
      <% if (user) { %>
      <div class="post-form-container">
        <form class="post-form" action="/posts" method="POST">
          <div class="post-form-avatar"><%= user.username.charAt(0).toUpperCase() %></div>
          <div class="post-form-content">
            <textarea name="content" placeholder="有什麼新鮮事？" oninput="this.style.height = ''; this.style.height = this.scrollHeight + 'px'"></textarea>
            <div class="post-form-actions">
              <div class="post-form-icons">
                <span class="post-form-icon">📷</span>
                <span class="post-form-icon">� GIF</span>
                <span class="post-form-icon">📊</span>
                <span class="post-form-icon">😊</span>
              </div>
              <button type="submit" class="btn-submit">發布</button>
            </div>
          </div>
        </form>
      </div>
      <% } %>

      <div id="following" class="feed-content active">
        <% if (myPosts && myPosts.length > 0) { %>
          <% myPosts.forEach(post => { %>
            <div class="post-card" onclick="window.location.href='/post/<%= post.id %>'">
              <div class="post-header">
                <div class="post-avatar"><%= post.username.charAt(0).toUpperCase() %></div>
                <div class="post-user-info">
                  <a href="/profile/<%= post.username %>" class="post-username" onclick="event.stopPropagation()"><%= post.username %></a>
                  <a href="/profile/<%= post.username %>" class="post-handle" onclick="event.stopPropagation()">@<%= post.username %></a>
                </div>
                <span class="post-time"><%= new Date(post.created_at).toLocaleString('zh-TW') %></span>
              </div>
              <div class="post-content"><%= post.content %></div>
              <div class="post-actions">
                <button class="action-btn">💬 0</button>
                <button class="action-btn">🔁 0</button>
                <button class="action-btn">❤️ 0</button>
                <button class="action-btn">📤</button>
              </div>
            </div>
          <% }) %>
        <% } else { %>
          <div class="empty-state">
            <p>尚無貼文</p>
            <% if (user) { %>
              <p>發布你的第一篇貼文吧！</p>
            <% } else { %>
              <p>登入後發布你的貼文</p>
            <% } %>
          </div>
        <% } %>
      </div>

      <div id="public" class="feed-content">
        <% if (allPosts && allPosts.length > 0) { %>
          <% allPosts.forEach(post => { %>
            <div class="post-card" onclick="window.location.href='/post/<%= post.id %>'">
              <div class="post-header">
                <div class="post-avatar"><%= post.username.charAt(0).toUpperCase() %></div>
                <div class="post-user-info">
                  <a href="/profile/<%= post.username %>" class="post-username" onclick="event.stopPropagation()"><%= post.username %></a>
                  <a href="/profile/<%= post.username %>" class="post-handle" onclick="event.stopPropagation()">@<%= post.username %></a>
                </div>
                <span class="post-time"><%= new Date(post.created_at).toLocaleString('zh-TW') %></span>
              </div>
              <div class="post-content"><%= post.content %></div>
              <div class="post-actions">
                <button class="action-btn">💬 0</button>
                <button class="action-btn">🔁 0</button>
                <button class="action-btn">❤️ 0</button>
                <button class="action-btn">📤</button>
              </div>
            </div>
          <% }) %>
        <% } else { %>
          <div class="empty-state">
            <p>尚無貼文</p>
            <p>成為第一個發布貼文的人吧！</p>
          </div>
        <% } %>
      </div>
    </main>

    <aside class="sidebar-right">
      <div class="search-box">
        <input type="text" placeholder="搜尋">
      </div>
      <div class="trending">
        <div class="trending-title">趨勢</div>
        <div class="trending-item">
          <div class="trending-category">科技 · 趨勢</div>
          <div class="trending-name">#WebDevelopment</div>
          <div class="trending-posts">1.2萬則貼文</div>
        </div>
        <div class="trending-item">
          <div class="trending-category">程式設計</div>
          <div class="trending-name">#JavaScript</div>
          <div class="trending-posts">8,543 則貼文</div>
        </div>
        <div class="trending-item">
          <div class="trending-category">生活</div>
          <div class="trending-name">#周末</div>
          <div class="trending-posts">5,231 則貼文</div>
        </div>
        <div class="trending-item">
          <div class="trending-category">美食</div>
          <div class="trending-name">#台灣美食</div>
          <div class="trending-posts">3,892 則貼文</div>
        </div>
      </div>
    </aside>
  </div>

  <script>
    function switchTab(tab) {
      document.querySelectorAll('.feed-tab').forEach(t => t.classList.remove('active'));
      document.querySelectorAll('.feed-content').forEach(c => c.classList.remove('active'));
      
      if (tab === 'following') {
        document.querySelectorAll('.feed-tab')[0].classList.add('active');
        document.getElementById('following').classList.add('active');
      } else {
        document.querySelectorAll('.feed-tab')[1].classList.add('active');
        document.getElementById('public').classList.add('active');
      }
    }
  </script>
</body>
</html>
