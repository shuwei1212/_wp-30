<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>發布新貼文 - Threads</title>
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>💬</text></svg>">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      background: #000;
      color: #e0e0e0;
      min-height: 100vh;
    }
    .container {
      max-width: 600px;
      margin: 0 auto;
      padding: 20px;
    }
    .header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 12px 0;
      border-bottom: 1px solid #2f3336;
      margin-bottom: 20px;
    }
    .back-btn {
      color: #1d9bf0;
      text-decoration: none;
      font-size: 18px;
    }
    .header-title { font-weight: 700; font-size: 20px; }
    .post-form {
      display: flex;
      gap: 12px;
    }
    .avatar {
      width: 48px;
      height: 48px;
      border-radius: 50%;
      background: linear-gradient(135deg, #833ab4, #fd1d1d, #fcb045);
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 700;
      color: #fff;
      font-size: 18px;
      flex-shrink: 0;
    }
    .form-content { flex: 1; }
    .form-content textarea {
      width: 100%;
      background: none;
      border: none;
      color: #e0e0e0;
      font-size: 20px;
      resize: none;
      outline: none;
      min-height: 150px;
      font-family: inherit;
    }
    .form-content textarea::placeholder { color: #71767b; }
    .btn-post {
      background: #1d9bf0;
      color: #fff;
      border: none;
      padding: 12px 24px;
      border-radius: 30px;
      font-weight: 700;
      cursor: pointer;
      transition: background 0.2s;
    }
    .btn-post:hover { background: #1a8cd8; }
    .btn-cancel {
      background: transparent;
      color: #f4212e;
      border: 1px solid #f4212e;
      padding: 12px 24px;
      border-radius: 30px;
      font-weight: 700;
      cursor: pointer;
      margin-right: 12px;
    }
    .actions {
      display: flex;
      justify-content: flex-end;
      margin-top: 20px;
      padding-top: 16px;
      border-top: 1px solid #2f3336;
    }
    .icons {
      display: flex;
      gap: 16px;
      margin-bottom: 12px;
    }
    .icon { font-size: 20px; cursor: pointer; }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <a href="/" class="back-btn">←</a>
      <span class="header-title">新貼文</span>
      <span></span>
    </div>
    <form class="post-form" action="/posts" method="POST">
      <div class="avatar"><%= user.username.charAt(0).toUpperCase() %></div>
      <div class="form-content">
        <textarea name="content" placeholder="有什麼新鮮事？" autofocus></textarea>
        <div class="icons">
          <span class="icon">📷</span>
          <span class="icon">� GIF</span>
          <span class="icon">📊</span>
          <span class="icon">😊</span>
          <span class="icon">📍</span>
        </div>
      </div>
    </form>
    <div class="actions">
      <a href="/" class="btn-cancel">取消</a>
      <button type="submit" form="post-form" class="btn-post">發布</button>
    </div>
  </div>
  <script>
    document.querySelector('form').addEventListener('submit', function(e) {
      const content = this.querySelector('textarea').value.trim();
      if (!content) {
        e.preventDefault();
        alert('請輸入內容');
      }
    });
  </script>
</body>
</html>
