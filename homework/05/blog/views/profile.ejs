<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>@<%= profileUser.username %> - Threads</title>
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>💬</text></svg>">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      background: #000;
      color: #e0e0e0;
      min-height: 100vh;
    }
    .container {
      max-width: 600px;
      margin: 0 auto;
    }
    .header {
      display: flex;
      align-items: center;
      padding: 12px 16px;
      border-bottom: 1px solid #2f3336;
      position: sticky;
      top: 0;
      background: rgba(0,0,0,0.65);
      backdrop-filter: blur(12px);
    }
    .back-btn {
      color: #1d9bf0;
      text-decoration: none;
      font-size: 18px;
    }
    .header-title { 
      font-weight: 700; 
      font-size: 20px; 
      margin-left: 20px;
    }
    .profile-header {
      padding: 20px 16px;
      border-bottom: 1px solid #2f3336;
    }
    .profile-banner {
      height: 120px;
      background: linear-gradient(135deg, #833ab4, #fd1d1d, #fcb045);
      border-radius: 16px;
      margin-bottom: -50px;
    }
    .profile-info {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      padding: 0 8px;
    }
    .avatar {
      width: 100px;
      height: 100px;
      border-radius: 50%;
      background: linear-gradient(135deg, #833ab4, #fd1d1d, #fcb045);
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 700;
      color: #fff;
      font-size: 36px;
      border: 4px solid #000;
    }
    .profile-actions {
      display: flex;
      gap: 8px;
    }
    .btn-follow {
      padding: 10px 20px;
      background: #fff;
      color: #000;
      border: none;
      border-radius: 20px;
      font-weight: 700;
      cursor: pointer;
    }
    .btn-message {
      padding: 10px 16px;
      background: transparent;
      color: #e0e0e0;
      border: 1px solid #536471;
      border-radius: 20px;
      font-weight: 700;
      cursor: pointer;
    }
    .profile-details {
      padding: 12px 16px;
    }
    .profile-name {
      font-weight: 700;
      font-size: 20px;
      margin-bottom: 4px;
    }
    .profile-handle {
      color: #71767b;
      font-size: 15px;
      margin-bottom: 12px;
    }
    .profile-bio {
      font-size: 15px;
      line-height: 1.5;
      margin-bottom: 12px;
    }
    .profile-stats {
      display: flex;
      gap: 20px;
      font-size: 14px;
    }
    .profile-stats span { color: #71767b; }
    .profile-stats strong { color: #e0e0e0; }
    .profile-joined {
      color: #71767b;
      font-size: 14px;
      margin-top: 8px;
    }
    .feed-tabs {
      display: flex;
      border-bottom: 1px solid #2f3336;
    }
    .feed-tab {
      flex: 1;
      padding: 16px;
      text-align: center;
      color: #71767b;
      cursor: pointer;
      font-weight: 500;
    }
    .feed-tab.active {
      color: #e0e0e0;
      font-weight: 700;
      border-bottom: 4px solid #fff;
    }
    .post-card {
      padding: 16px;
      border-bottom: 1px solid #2f3336;
      cursor: pointer;
      transition: background 0.2s;
    }
    .post-card:hover { background: #16181a; }
    .post-header {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 8px;
    }
    .post-avatar {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      background: linear-gradient(135deg, #833ab4, #fd1d1d, #fcb045);
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 700;
      color: #fff;
      font-size: 14px;
    }
    .post-user-info { flex: 1; }
    .post-username { font-weight: 700; font-size: 15px; text-decoration: none; color: #e0e0e0; }
    .post-username:hover { text-decoration: underline; }
    .post-handle { color: #71767b; font-size: 14px; text-decoration: none; }
    .post-handle:hover { text-decoration: underline; }
    .post-time { color: #71767b; font-size: 14px; }
    .post-content {
      font-size: 15px;
      line-height: 1.5;
      margin-left: 52px;
      margin-bottom: 12px;
    }
    .post-actions {
      display: flex;
      justify-content: space-around;
      margin-left: 52px;
      max-width: 400px;
    }
    .action-btn {
      display: flex;
      align-items: center;
      gap: 6px;
      color: #71767b;
      font-size: 13px;
      background: none;
      border: none;
      cursor: pointer;
      padding: 8px;
      border-radius: 20px;
      transition: background 0.2s, color 0.2s;
    }
    .action-btn:hover { background: #1a1a1a; }
    .action-btn svg { width: 18px; height: 18px; }
    .empty-state {
      padding: 40px 20px;
      text-align: center;
      color: #71767b;
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <a href="/" class="back-btn">←</a>
      <span class="header-title"><%= profileUser.username %></span>
    </div>
    
    <div class="profile-header">
      <div class="profile-banner"></div>
      <div class="profile-info">
        <div class="avatar"><%= profileUser.username.charAt(0).toUpperCase() %></div>
        <div class="profile-actions">
          <% if (isOwnProfile) { %>
            <button class="btn-follow" onclick="window.location.href='/new'">發布</button>
          <% } else { %>
            <button class="btn-message">訊息</button>
          <% } %>
        </div>
      </div>
    </div>
    
    <div class="profile-details">
      <div class="profile-name"><%= profileUser.username %></div>
      <div class="profile-handle">@<%= profileUser.username %></div>
      <div class="profile-bio">歡迎來到 <%= profileUser.username %> 的個人頁面</div>
      <div class="profile-stats">
        <span><strong><%= posts.length %></strong> 貼文</span>
        <span><strong>0</strong> 追蹤中</span>
        <span><strong>0</strong> 追蹤者</span>
      </div>
      <div class="profile-joined">
        加入於 <%= new Date(profileUser.created_at).toLocaleDateString('zh-TW', { year: 'numeric', month: 'long' }) %>
      </div>
    </div>
    
    <div class="feed-tabs">
      <div class="feed-tab active">貼文</div>
      <div class="feed-tab">回覆</div>
      <div class="feed-tab">媒體</div>
    </div>
    
    <div id="posts" class="feed-content active">
      <% if (posts && posts.length > 0) { %>
        <% posts.forEach(post => { %>
          <div class="post-card" onclick="window.location.href='/post/<%= post.id %>'">
            <div class="post-header">
              <div class="post-avatar"><%= post.username.charAt(0).toUpperCase() %></div>
              <div class="post-user-info">
                <a href="/profile/<%= profileUser.username %>" class="post-username" onclick="event.stopPropagation()"><%= profileUser.username %></a>
                <a href="/profile/<%= profileUser.username %>" class="post-handle" onclick="event.stopPropagation()">@<%= profileUser.username %></a>
              </div>
              <span class="post-time"><%= new Date(post.created_at).toLocaleString('zh-TW') %></span>
            </div>
            <div class="post-content"><%= post.content %></div>
            <div class="post-actions">
              <button class="action-btn">💬 0</button>
              <button class="action-btn">🔁 0</button>
              <button class="action-btn">❤️ 0</button>
              <button class="action-btn">📤</button>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <div class="empty-state">
          <p>尚無貼文</p>
        </div>
      <% } %>
    </div>
  </div>
</body>
</html>
