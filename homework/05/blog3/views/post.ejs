<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Threads</title>
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>💬</text></svg>">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      background: #000;
      color: #e0e0e0;
      min-height: 100vh;
    }
    .container {
      max-width: 600px;
      margin: 0 auto;
      padding: 0;
    }
    .header {
      display: flex;
      align-items: center;
      padding: 12px 16px;
      border-bottom: 1px solid #2f3336;
      position: sticky;
      top: 0;
      background: rgba(0,0,0,0.65);
      backdrop-filter: blur(12px);
    }
    .back-btn {
      color: #1d9bf0;
      text-decoration: none;
      font-size: 18px;
    }
    .header-title { 
      font-weight: 700; 
      font-size: 20px; 
      margin-left: 20px;
    }
    .post-detail {
      padding: 16px;
      border-bottom: 1px solid #2f3336;
    }
    .post-header {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 12px;
    }
    .avatar {
      width: 48px;
      height: 48px;
      border-radius: 50%;
      background: linear-gradient(135deg, #833ab4, #fd1d1d, #fcb045);
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 700;
      color: #fff;
      font-size: 18px;
    }
    .user-info { flex: 1; }
    .username { font-weight: 700; font-size: 16px; }
    .handle { color: #71767b; font-size: 14px; }
    .post-content {
      font-size: 18px;
      line-height: 1.5;
      margin-left: 60px;
      margin-bottom: 16px;
      white-space: pre-wrap;
    }
    .post-time {
      color: #71767b;
      font-size: 15px;
      margin-left: 60px;
      padding-bottom: 16px;
      border-bottom: 1px solid #2f3336;
    }
    .post-actions {
      display: flex;
      justify-content: space-around;
      padding: 12px 0;
      border-bottom: 1px solid #2f3336;
    }
    .action-btn {
      display: flex;
      align-items: center;
      gap: 6px;
      color: #71767b;
      font-size: 13px;
      background: none;
      border: none;
      cursor: pointer;
      padding: 8px 12px;
      border-radius: 20px;
      transition: background 0.2s, color 0.2s;
    }
    .action-btn:hover { background: #1a1a1a; }
    .action-btn svg { width: 20px; height: 20px; }
    .action-btn.reply:hover { color: #1d9bf0; }
    .action-btn.repost:hover { color: #00ba7c; }
    .action-btn.like:hover { color: #f91880; }
    .action-btn.share:hover { color: #1d9bf0; }
    .actions-row {
      display: flex;
      justify-content: space-between;
      padding: 12px 0;
    }
    .edit-delete {
      display: flex;
      gap: 12px;
      margin-top: 16px;
      padding-top: 16px;
      border-top: 1px solid #2f3336;
    }
    .btn {
      padding: 10px 20px;
      border-radius: 20px;
      font-weight: 700;
      cursor: pointer;
      text-decoration: none;
      font-size: 14px;
    }
    .btn-edit {
      background: #1d9bf0;
      color: #fff;
      border: none;
    }
    .btn-delete {
      background: transparent;
      color: #f4212e;
      border: 1px solid #f4212e;
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <a href="/" class="back-btn">←</a>
      <span class="header-title">貼文</span>
    </div>
    <div class="post-detail">
      <div class="post-header">
        <div class="avatar"><%= post.username.charAt(0).toUpperCase() %></div>
        <div class="user-info">
          <div class="username"><%= post.username %></div>
          <div class="handle">@<%= post.username %></div>
        </div>
      </div>
      <div class="post-content"><%= post.content %></div>
      <div class="post-time"><%= new Date(post.created_at).toLocaleString('zh-TW') %></div>
      
      <div class="post-actions">
        <button class="action-btn reply">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M1.751 10c0-4.42 3.584-8 8.005-8h4.366c4.49 0 8.129 3.64 8.129 8.13 0 2.96-1.607 5.68-4.196 7.11l-8.054 4.46v-3.69h-.067c-4.49.1-8.183-3.51-8.183-8.01zm8.005-6c-3.317 0-6.005 2.69-6.005 6 0 3.37 2.77 6.08 6.138 6.01l.351-.01h1.761v2.3l5.087-2.81c1.951-1.08 3.163-3.13 3.163-5.36 0-3.39-2.744-6.13-6.129-6.13H9.756z"/></svg>
          回覆
        </button>
        <button class="action-btn repost">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M4.5 3.88l4.432 4.14-1.364 1.46L5.5 7.55V16c0 1.1.896 2 2 2H13v2H7.5c-2.209 0-4-1.79-4-4V7.55L1.432 9.48.068 8.02 4.5 3.88zM16.5 6H11V4h5.5c2.209 0 4 1.79 4 4v8.45l2.068-1.93 1.364 1.46-4.432 4.14-4.432-4.14 1.364-1.46 2.068 1.93V8c0-1.1-.896-2-2-2z"/></svg>
          轉發
        </button>
        <button class="action-btn like">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M16.697 5.5c-1.222-.06-2.679.51-3.89 2.16l-.805 1.09-.806-1.09C9.984 6.01 8.526 5.44 7.304 5.5c-1.243.07-2.349.78-2.91 1.91-.552 1.12-.633 2.78.479 4.82 1.074 1.97 3.257 4.27 7.129 6.61 3.87-2.34 6.052-4.64 7.126-6.61 1.111-2.04 1.03-3.7.477-4.82-.561-1.13-1.666-1.84-2.908-1.91zm4.187 7.69c-1.351 2.48-4.001 5.12-8.379 7.67l-.503.3-.504-.3c-4.379-2.55-7.029-5.19-8.382-7.67-1.36-2.5-1.41-4.86-.514-6.67.887-1.79 2.647-2.91 4.601-3.01 1.651-.09 3.368.56 4.798 2.01 1.429-1.45 3.146-2.1 4.796-2.01 1.954.1 3.714 1.22 4.601 3.01.896 1.81.846 4.17-.514 6.67z"/></svg>
          喜歡
        </button>
        <button class="action-btn share">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.59l5.7 5.7-1.41 1.42L13 6.41V16h-2V6.41l-3.3 3.3-1.41-1.42L12 2.59zM21 15l-.02 3.51c0 1.38-1.12 2.49-2.5 2.49H5.5C4.11 21 3 19.88 3 18.5V15h2v3.5c0 .28.22.5.5.5h12.98c.28 0 .5-.22.5-.5L19 15h2z"/></svg>
          分享
        </button>
      </div>
      
      <% if (user && user.id === post.user_id) { %>
      <div class="edit-delete">
        <a href="/edit/<%= post.id %>" class="btn btn-edit">編輯</a>
        <form action="/delete/<%= post.id %>" method="POST" style="display:inline;">
          <button type="submit" class="btn btn-delete" onclick="return confirm('確定要刪除嗎？')">刪除</button>
        </form>
      </div>
      <% } %>
    </div>
  </div>
</body>
</html>
